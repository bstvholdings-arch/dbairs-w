generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. 租户表 (Tenant - 你的下游客户)
model Tenant {
  id        String @id @default(uuid())
  name      String // 品牌名称 (如 Winvora)
  domain    String @unique // 绑定域名
  subdomain String @unique // 系统分配的子域名
  status    String @default("active") // active, suspended, trial
  planId    String // 关联的套餐 ID

  // 出金审批人数设置（最少1人，最多3人，后台可调）
  withdrawalRequiredApprovals Int @default(1)

  // 租户记账货币（玩家钱包余额、提现、统计金额的统一币种）
  // 前端一律用 src/lib/currency.ts 的 formatCurrency() 渲染符号（RM / $ / ฿ / Rp…），
  // 不允许在组件里写死 `$`。可选值见 SUPPORTED_CURRENCIES。
  currency String @default("MYR")

  // 前台装修（Storefront Settings，超管在 /admin/storefront 可视化配置）
  // themeColor：玩家大厅主色调，默认金色 #d4af37
  // layoutConfig：模块开关、顺序与互动组件，形如
  //   {
  //     "modules": [{ "id": "hero", "visible": true }, { "id": "action", "visible": true }, { "id": "provider", "visible": false }],
  //     "preset": "classic",             // 排版模板：classic / cinema / compact / bento / editorial
  //     "gameCardStyle": "cyberNeon",    // 游戏封面风格：cyberNeon / royalGold / candyPop（只能由超管在【租户管理 → 新增 / 编辑】写入，商户后台只读）
  //     "showTopbarChat": true,          // 顶栏语言按钮左侧的 AI 客服图标
  //     "showSidebarCasinoAnim": true,   // 侧边栏「斗鸡」下方的娱乐场动态卡片
  //     "languageStyle": "CH/EN"         // 语言按钮中文标签/英文标签，英文固定 EN
  //   }
  //   null / 非法值一律回退到全模块显示 + 互动组件全开（见 src/lib/storefront.ts）
  themeColor   String @default("#d4af37")
  layoutConfig Json?

  // 洗码（返水）配置：**唯一事实来源**，商户后台 /tenant/rebates 自行维护。
  // 形如
  //   { "version": 1,
  //     "categories": {
  //       "slot": { "ratePercent": 0.5,  "isActive": true },
  //       "live": { "ratePercent": 0.2,  "isActive": false },
  //       "sport": { "ratePercent": 0.2, "isActive": false },
  //       "poker": { "ratePercent": 0.2, "isActive": false },
  //       "fish":  { "ratePercent": 0.2, "isActive": false },
  //       "cockfight": { "ratePercent": 0.2, "isActive": false }
  //     } }
  // - ratePercent 是**百分比**：0.5 = 0.5%（不是 50%），与后台输入框「%」一栏一一对应；
  // - isActive 是**每个品类独立**的总开关，false 时该品类一律不结算（哪怕 ratePercent > 0）；
  // - 读侧一律过 src/lib/rebate-config.ts 的 normalizeRebateConfig()：
  //   null / 脏数据 / 缺品类 → 全部品类视为「关闭 + 0 费率」（宁可少发，不可误发）。
  rebateConfig Json?

  // 自动出款引擎（Auto Payout）：**唯一事实来源**，商户后台 /tenant/withdrawals 自行维护。
  // 形如 { "isEnabled": true, "maxAutoAmount": 100, "dailyAutoLimit": 1000 }
  // - isEnabled：总开关，false 时所有提现一律进人工审核队列（fail-closed）；
  // - maxAutoAmount：单笔自动出款上限，超过就转人工（防大额误打）；
  // - dailyAutoLimit：每日自动出款总额上限，达线即熔断，当天剩余订单全部转人工。
  // 读侧一律过 src/lib/auto-payout.ts 的 normalizeAutoPayoutConfig()：
  // null / 脏数据 / 非数字 → isEnabled=false（宁可全人工，不可自动乱打钱）。
  // ⚠️ 自动出款成立还有一个硬前提：该笔提现用的支付网关必须配了 payoutEndpoint
  //    （商户自己的代付 API 地址），没配就一律人工，配置面板在提现审批页。
  autoPayoutConfig Json?

  // API 集成中心（/admin/integrations）：商户对接资料
  // contactEmail：对接联系邮箱，发送 / 重置密钥时的默认收件人
  // apiCallbackUrl：商户专属回调地址，留空表示使用平台默认回调
  // apiKey：商户专属 API Key，明文入库（与 PaymentGateway.apiKey 同一口径），
  //         所有列表 / 详情接口只返回掩码；重置接口仅在响应里返回一次新密钥
  contactEmail    String?
  apiCallbackUrl  String?
  apiKey          String?
  apiKeyUpdatedAt DateTime?

  // API 集成中心「商户资料（Merchant Profiles）」
  // backendIp：商户回传资金 / 注单的服务端出口 IP（与全局白名单配合做来源校验）
  // walletAddress：商户结算收款钱包（USDT TRC20 / ERC20 等，仅展示与人工核对）
  backendIp     String?
  walletAddress String?

  // 多域名池（防封自动切换）：商户自有的 1-5 个备用域名。
  // 前台 <DomainGuard /> 在主线路连续心跳超时后跳到这里（见 src/lib/tenant-domains.ts）。
  // ⚠️ 备用域名必须同时参与租户解析（storefront-data.ts 的 findTenantByDomain），
  //    否则跳过去就等于「站点不存在」；跨租户唯一性由 tenant-domain-service.ts 校验。
  // 入库前一律走 normalizeDomain()：小写、去协议、去路径、去末尾点。
  backupDomains String[] @default([])

  // 玩家前台品牌展示（白标）：商户自己的 Logo 图片地址
  // logoUrl：http(s) 绝对地址，或 / 开头的站内路径
  //          （超管上传接口 POST /api/admin/tenant-logos/upload 返回的
  //            /api/tenant-logos/<uuid>.png 就是这种路径）；
  //          留空则前台用「商户名首字母」生成占位图
  //          （见 src/components/brand/tenant-brand.tsx）。
  //          ⚠️ 权限：**只有超管能写** —— 唯一写入口是 POST /api/tenants 与
  //             PUT /api/tenants/[id]（编辑租户弹窗里的上传组件）；商户后台
  //             /tenant/settings 已彻底移除上传 / 修改入口，PATCH /api/tenant/settings
  //             也会显式忽略 logoUrl。读取侧走 normalizeTenantLogoUrl() 校验。
  logoUrl String?

  // Logo 显示位置（玩家大厅顶栏）：left = 左侧品牌区（默认，= 改造前的排版）；
  // center = 屏幕正中央。全局只渲染**一个** Logo 实例 —— 居中时左侧让位给
  // 菜单按钮、右侧放搜索 / 语言 / 余额，不会出现「左边一个、中间又一个」。
  // 与 logoUrl 同一权限口径：只能由超管在【租户管理 → 新增 / 编辑】写入；
  // 商户后台（/api/tenant/settings）与装修页（/api/admin/storefront）都不认这个字段。
  // 脏数据 / 老租户缺字段一律回落 "left"（见 src/lib/storefront.ts）。
  logoPosition String @default("left")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players          Player[]
  agents           Agent[]
  transactions     Transaction[]
  withdrawals      Withdrawal[]
  providerPoints   TenantProviderPoint[]
  betRecords       BetRecord[]
  paymentGateways  PaymentGateway[]
  depositOrders    DepositOrder[]
  referralRewards  ReferralReward[]
  dailyBonusClaims DailyBonusClaim[]
  agentFaqs        AgentFaq[]
  aiChatLogs       AiChatLog[]
  kycRecords       PlayerKyc[]

  withdrawalAccounts PlayerWithdrawalAccount[]

  promotionCategories PromotionCategory[]
  promotionBanners    PromotionBanner[]

  bonusCampaigns BonusCampaign[]
  bonusClaims    PlayerBonusClaim[]
  rebatePayouts  RebatePayout[]
}

// 2. 套餐表 (Plan - 标准版/高阶版配置)
model Plan {
  id                  String   @id @default(uuid())
  name                String // 名称：Standard, Premium
  setupFee            Decimal  @db.Decimal(18, 2) // 开台费
  monthlyFee          Decimal  @db.Decimal(18, 2) // 月费
  platformFeeRate     Decimal  @db.Decimal(5, 4) // 平台抽水 (如 0.05)
  agentCommissionRate Decimal  @db.Decimal(5, 4) // 代理分润 (如 0.15)
  trafficLimitGB      Int // 流量限制 (如 150)
  isUnlimitedTraffic  Boolean  @default(false)
  createdAt           DateTime @default(now())
}

// 3. 玩家表 (Player)
model Player {
  id               String    @id @default(uuid())
  tenantId         String // 多租户隔离字段
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  username         String // 玩家账号
  passwordHash     String
  email            String? // 电子邮箱：注册必填、登录可用；同一租户内唯一（历史数据可为空）
  phone            String? // 手机号：注册必填、登录可用；存 E.164 形式（如 +60123456789），同一租户内唯一
  balance          Decimal   @default(0.00) @db.Decimal(18, 6) // 资金余额
  status           String    @default("active")
  walletAddress    String? // 玩家常用提现 / 收款地址（安全中心可维护）
  referralCode     String    @unique // 玩家专属推广码，注册时自动生成
  resetToken       String?   @unique // 一次性找回密码 Token（UUID），使用后立即清空
  resetTokenExpiry DateTime? // Token 过期时间（默认 30 分钟）
  referredById     String? // 推荐人（同租户玩家）；注册后不可改
  referredBy       Player?   @relation("PlayerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        Player[]  @relation("PlayerReferrals")
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())

  transactions    Transaction[]
  betRecords      BetRecord[]
  depositOrders   DepositOrder[]
  withdrawals     Withdrawal[]
  dailyBonuses    DailyBonusClaim[]
  referralRewards ReferralReward[]  @relation("ReferralInviter")
  aiChatLogs      AiChatLog[]
  kyc             PlayerKyc? // 实名认证（一人一条，驳回后可重新提交覆盖）
  withdrawalAccounts PlayerWithdrawalAccount[] // 全球法币 / 加密货币提现账号（可多条，一条默认）
  bonusClaims     PlayerBonusClaim[] // 红利领取记录（流水要求锁）
  rebatePayouts   RebatePayout[] // 每日洗码结算记录

  @@unique([tenantId, username]) // 同一个站内账号唯一
  @@unique([tenantId, email]) // 同一站内邮箱唯一（NULL 不参与唯一约束）
  @@unique([tenantId, phone]) // 同一站内手机号唯一（NULL 不参与唯一约束）
  @@index([tenantId, referredById])
}

// 3.1 推广奖励 (ReferralReward)
// 被邀请玩家首充成功后，按 REFERRAL_REWARD_RATE（默认 5%）给邀请人返佣。
// 同一笔充值订单只允许返佣一次（depositOrderId 唯一），防止回调重试重复入账。
model ReferralReward {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviterId        String
  inviter          Player        @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  referredPlayerId String // 只存 ID：被邀请人注销后仍保留返佣记录
  depositOrderId   String?       @unique
  depositOrder     DepositOrder? @relation(fields: [depositOrderId], references: [id], onDelete: SetNull)
  depositAmount    Decimal       @db.Decimal(18, 6)
  rewardRate       Decimal       @db.Decimal(5, 4)
  rewardAmount     Decimal       @db.Decimal(18, 6)
  currency         String        @default("USDT")
  createdAt        DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([inviterId, createdAt])
  @@index([referredPlayerId])
}

// 3.2 每日签到 (DailyBonusClaim)
// 每个玩家每天（UTC 日期）只能领取一次；金额由 DAILY_BONUS_AMOUNT 控制，默认 0.50。
model DailyBonusClaim {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  claimDate     DateTime @db.Date
  amount        Decimal  @db.Decimal(18, 6)
  currency      String   @default("USDT")
  transactionId String?  @unique // 对应的奖励流水
  createdAt     DateTime @default(now())

  @@unique([playerId, claimDate])
  @@index([tenantId, claimDate])
}

// 4. 代理表 (Agent - 推广人员)
model Agent {
  id             String   @id @default(uuid())
  tenantId       String // 多租户隔离字段
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  username       String
  passwordHash   String
  commissionRate Decimal  @default(0.00) @db.Decimal(5, 4) // 独立佣金比例
  balance        Decimal  @default(0.00) @db.Decimal(18, 6) // 可提现佣金
  createdAt      DateTime @default(now())

  @@unique([tenantId, username])
}

// 5. 财务流水表 (Transaction - 核心账本)
model Transaction {
  id        String   @id @default(uuid())
  tenantId  String // 多租户隔离字段
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  playerId  String? // 关联玩家(如果是玩家充值/提现/下注)
  type      String // deposit(充值), withdraw(提现), bet(下注), win(派彩)
  amount    Decimal  @db.Decimal(18, 6) // 金额
  currency  String   @default("USDT")
  status    String   @default("success") // success, pending, failed
  txHash    String? // 区块链哈希或支付网关单号
  createdAt DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id])
}

// 6. 出金表 (Withdrawal - 提现申请 / 代付结果)
// 纯电子记账：pending 不扣余额；代付成功回调后才扣 Player.balance 并写 Transaction(type=withdraw)。
// 不创建任何平台内部资金账户，也不做内部划转。
model Withdrawal {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  playerId          String?
  player            Player?         @relation(fields: [playerId], references: [id], onDelete: SetNull)
  amount            Decimal         @db.Decimal(18, 6)
  currency          String          @default("USDT")
  status            String          @default("pending") // pending 人工待审 / processing 自动出款中 / success 已出款 / failed 已驳回或出款失败
  /**
   * 风险 / 路由原因快照（智能路由判定结果，便于商户一眼看出「为什么这单没自动出」）：
   * auto_queued          自动出款已受理，正在等代付商结果
   * auto_paid            自动出款成功（与 success 同时出现）
   * auto_payout_failed   代付 API 调用失败，已退回人工审核队列
   * auto_payout_unsettled 代付成功但扣款失败（余额被并发花掉），需人工对账
   * manual_disabled      商户关着自动出款开关
   * manual_no_payout_api 该通道没配代付 API
   * manual_over_single_limit 超过单笔自动上限
   * manual_daily_limit  当日自动出款额度已熔断
   * manual_kyc_pending  实名未通过
   * manual_bonus_turnover 红利流水未打满
   * null = 历史数据（改造前就没有这个字段）
   */
  riskStatus        String?
  /** 这单是否走了自动出款通道（true 的金额才计入当日额度与熔断阈值） */
  isAuto            Boolean         @default(false)
  walletAddress     String // 提现钱包地址
  gatewayId         String? // 代付通道，用于回调验签
  gateway           PaymentGateway? @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  txHash            String? // 代付商交易号
  approvals         Int             @default(0)
  requiredApprovals Int             @default(1)
  processedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@index([tenantId, status])
  @@index([playerId, createdAt])
  @@index([gatewayId])
  // 熔断判定按「当日 + isAuto」聚合总额，走这条索引
  @@index([tenantId, isAuto, createdAt])
}

// 6.1 玩家提现账号 (PlayerWithdrawalAccount - 全球法币 / 加密货币收款账号)
// 一个玩家可绑定多个收款账号，同一「币种 + 网络」只保留一条（重复提交做覆盖更新）。
// - accountType = "crypto"：只用 walletAddress（currency=USDT，network=TRC20 / ERC20）；
// - accountType = "bank"  ：只用 bankName / accountNumber / accountName（法币银行账户）。
// network 对法币账号存空字符串而不是 NULL：Postgres 里 NULL 不参与唯一比较，
// 用空串才能让「同一玩家同一法币」也被 @@unique 拦住。
// isDefault 每个玩家最多一条，写入时先清空其它账号再落库（见 /api/player/withdrawal-accounts）。
// 默认的加密货币账号会同步回写 Player.walletAddress，兼容旧提现流程与商户后台展示。
model PlayerWithdrawalAccount {
  id            String   @id @default(uuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency      String // USDT / MYR / THB / IDR / VND / AUD / SGD / EUR / USD / HKD / NPR / INR
  network       String   @default("") // 加密货币网络：TRC20 / ERC20；法币为空串
  accountType   String   @default("crypto") // crypto, bank
  walletAddress String? // 加密货币钱包地址
  bankName      String? // 银行名称（法币）
  accountNumber String? // 银行账号（法币）
  accountName   String? // 账户持有人姓名（法币）
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([playerId, currency, network])
  @@index([tenantId, createdAt])
  @@index([playerId, isDefault])
}

// 7. 后台管理员表 (AdminUser - 用于 Super Admin 和 租户老板登录)
// role 决定后台可见的菜单与可调用的接口（RBAC 矩阵见 src/lib/rbac.ts）：
//   super_admin：平台全部权限（含员工管理）
//   finance    ：数据大盘 + 财务对账 + 出金审批
//   tech       ：游戏商 / 游戏库技术配置（含后续 AI 日志）
//   support    ：客服，仅数据大盘
//   tenant_admin：租户老板，只能进 /tenant 控制台
// AdminUser 由超管在 /admin/staff 创建，所以默认角色取最小权限的 support；
// 建站脚本（prisma/seed.ts）会显式写入 super_admin。
enum AdminRole {
  super_admin
  finance
  tech
  support
  tenant_admin
}

model AdminUser {
  id               String    @id @default(uuid())
  tenantId         String? // 如果是空，代表平台员工；如果有值，代表是某个站的老板
  username         String    @unique
  passwordHash     String
  // 后台账号原本只有 username；按邮箱找回密码必须先有邮箱字段。
  email            String?   @unique
  phone            String? // 联系手机号（E.164，如 +60123456789）；商户账号按租户内唯一
  resetToken       String?   @unique // 一次性找回密码 Token（UUID），使用后立即清空
  resetTokenExpiry DateTime? // Token 过期时间（默认 30 分钟）
  role             AdminRole @default(support)
  createdAt        DateTime  @default(now())

  reviewedKycs PlayerKyc[] @relation("KycReviewer")

  // 同一租户内邮箱 / 手机号不重复（平台员工的 tenantId 为 NULL，由上面的全局 @unique 兜底）
  @@unique([tenantId, email])
  @@unique([tenantId, phone])
}

// 8. 游戏商表 (GameProvider - GGR 点数结算配置)
// 点数只用于分配 GGR（总下注额 - 总派彩额），绝不能乘以总流水 Turnover。
model GameProvider {
  id              String   @id @default(uuid())
  name            String   @unique // 游戏商名称
  upstreamPoint   Decimal  @db.Decimal(5, 4) // 上游点数，如 0.94（游戏商分走 6% GGR）
  platformMarkup  Decimal  @db.Decimal(5, 4) // 平台加点，如 0.02（平台分走 2% GGR）
  downstreamPoint Decimal  @db.Decimal(5, 4) // 下游点数，由 upstreamPoint - platformMarkup 计算写入
  status          String   @default("active") // active, suspended（结算状态）
  // 大厅展示控制：sortOrder 越大越靠前；isActive=false 时前台大厅与游戏商筛选 Tab 都不展示。
  // 与 status 解耦：下架不影响历史注单结算。
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  // 首页【游戏商商标网格 / 品牌墙】独立开关：false 时只是不出现在大厅品牌墙，
  // 展馆页与游戏目录照旧可用（想彻底下架请改 isActive）。
  // 品牌墙内的顺序同样由 sortOrder 决定：数字越大越靠前。
  showInShowcase  Boolean  @default(true)

  // API 集成中心「游戏商（Game Providers）」对接凭据
  // apiEndpoint：游戏商提供的接入地址（下单 / 余额 / 同步接口的 base URL）
  // merchantId ：游戏商分配给平台的商户号
  // apiSecret  ：游戏商分配的签名密钥，明文只用于服务端签名，列表接口一律下发掩码
  apiEndpoint String?
  merchantId  String?
  apiSecret   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantPoints TenantProviderPoint[]
  betRecords   BetRecord[]
  games        Game[]

  @@index([status])
  @@index([isActive, sortOrder])
}

// 8.1 游戏表 (Game - 从游戏商同步过来的游戏目录)
// 同步以 [providerId, externalId] 为唯一键做 upsert：
// 游戏名 / 品类会被上游覆盖，但后台设置的 sortOrder、isActive 不会被同步重置。
model Game {
  id         String       @id @default(uuid())
  providerId String
  provider   GameProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  externalId String // 游戏商侧的游戏编码，用于同步去重
  name       String // 游戏名称，如 Mahjong Ways 2
  category   String       @default("slot") // slot, live, fish（对应大厅分类）
  iconUrl    String? // 上游封面图，缺失时前台用渐变色块占位
  sortOrder  Int          @default(0) // 大厅同分类内的排序，越大越靠前
  isActive   Boolean      @default(true) // 上架 / 下架
  syncedAt   DateTime     @default(now()) // 最近一次同步时间
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([providerId, externalId])
  @@index([providerId, isActive])
  @@index([isActive, sortOrder])
  @@index([category, isActive])
}

// 9. 租户专属点数覆盖 (TenantProviderPoint)
// 存在记录时，该租户在该游戏商下使用 customPoint 作为最终下游点数；
// 不存在记录时，回退到 GameProvider 的全局 downstreamPoint。
model TenantProviderPoint {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  providerId  String
  provider    GameProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customPoint Decimal      @db.Decimal(5, 4) // 专属最终下游点数，例如 0.9300
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, providerId])
  @@index([providerId])
}

// 10. 注单表 (BetRecord - 历史结算快照)
// snapshotPoint 等字段在玩家下注瞬间写入，后续后台修改点数不会重算历史账单。
model BetRecord {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  providerId String
  provider   GameProvider @relation(fields: [providerId], references: [id])
  playerId   String?
  player     Player?      @relation(fields: [playerId], references: [id])

  externalId   String? // 游戏商注单号
  // 游戏品类（slot / live / sport / poker / fish / cockfight / esport）：
  // 回调带 gameCode 时按 [providerId, externalId=gameCode] 回查 Game.category 写入，
  // 查不到时回落 "slot"。**洗码（返水）结算只认这一列**，
  // 一旦写入就不再变动（历史账单不会因为游戏改品类而被重算）。
  gameCategory String  @default("slot")
  currency     String  @default("USDT")
  betAmount    Decimal @db.Decimal(18, 6) // 总下注额
  payoutAmount Decimal @db.Decimal(18, 6) // 总派彩额
  ggrAmount    Decimal @db.Decimal(18, 6) // 下注时 GGR = betAmount - payoutAmount

  // 下注瞬间快照：历史账单唯一可信来源
  snapshotPoint          Decimal @db.Decimal(5, 4) // 最终下游点数（专属优先）
  snapshotUpstreamPoint  Decimal @db.Decimal(5, 4) // 当时上游点数
  snapshotPlatformMarkup Decimal @db.Decimal(5, 4) // 当时实际平台点差 = 上游点数 - 最终下游点数

  status    String    @default("settled") // settled, void
  settledAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([providerId, externalId]) // 防止游戏商回调重试造成重复注单
  @@index([tenantId, createdAt])
  @@index([tenantId, gameCategory, createdAt]) // 每日洗码结算按「商户 + 品类 + 日界」聚合
  @@index([providerId, createdAt])
  @@index([playerId])
}

// 11. 支付网关形态
// 与具体支付商（providerType）解耦，描述玩家最终如何完成支付。
enum GatewayType {
  REDIRECT_URL
  DYNAMIC_QR
  STATIC_QR
  BANK_TRANSFER
}

// 12. 租户自有网关审核状态
// 平台网关默认 APPROVED；租户自行接入的网关提交后为 PENDING，超管审核后变更。
enum GatewayReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// 13. 支付网关 (PaymentGateway - 充值通道配置)
// ownerId 为空代表平台公用网关；有值代表只允许该租户使用。
// isPlatformGateway 区分平台提供的网关与租户自己接入的网关。
// 费率均为小数，例如 0.005 = 0.5%；平台利润 = 售价 - 成本。
model PaymentGateway {
  id             String      @id @default(uuid())
  name           String // 网关名称，如 USDT-TRC20、银行网银
  providerType   String // usdt_trc20, usdt_erc20, tng, duitnow, sepa, payid, swift, bank_transfer, other
  gatewayType    GatewayType @default(DYNAMIC_QR)
  currency       String      @default("USDT")
  walletAddress  String? // USDT 收款钱包地址（TRC20 / ERC20）；非 USDT 网关可为空
  qrCodeImageUrl String? // STATIC_QR 的收款图片（http/https URL 或 data:image base64）
  bankDetails    Json? // BANK_TRANSFER 的银行信息（户名、账号、SWIFT/BIC、IBAN、PayID 等）

  // REDIRECT_URL（网银跳转）时玩家可选的银行列表（银行编码，见 src/lib/payment-gateway-banks.ts）。
  // - 只在 /tenant/payments 的商户自有通道里维护，玩家收银台据此渲染银行卡片；
  // - 空数组 = 不做银行选择，玩家直接跳支付商收银台（由支付商页面选银行）；
  // - 下单时服务端强制校验：玩家提交的银行必须在此列表内，否则 400，绝不信任前端。
  supportedBanks String[] @default([])
  endpoint       String // REDIRECT_URL / DYNAMIC_QR 的**收款**接口地址（入金用）
  apiKey         String // 回调验签密钥 / 代付请求签名密钥，接口只返回掩码

  // 代付 API 地址（出金用，与上面的收款 endpoint 是两条独立链路）。
  // - 由商户在自己的后台「提现审批 → 自动出款引擎」里填写，保存即生效；
  // - 空值 = 该通道没有代付能力 → 用这条通道的提现单一律进人工审核队列，
  //   这是「智能路由」的判定条件之一（见 src/lib/auto-payout.ts）；
  // - 平台通道（ownerId=null）不允许配置代付地址：资金不经过平台，合法底线。
  payoutEndpoint String?

  // 平台通道成本 / 对租户售价。代收、代付、结算三条业务线独立定价。
  payinCostRate      Decimal @default(0) @db.Decimal(8, 6)
  payinSellRate      Decimal @default(0) @db.Decimal(8, 6)
  payoutCostRate     Decimal @default(0) @db.Decimal(8, 6)
  payoutSellRate     Decimal @default(0) @db.Decimal(8, 6)
  settlementCostRate Decimal @default(0) @db.Decimal(8, 6)
  settlementSellRate Decimal @default(0) @db.Decimal(8, 6)

  isPlatformGateway Boolean             @default(true)
  reviewStatus      GatewayReviewStatus @default(APPROVED)
  reviewNote        String?
  reviewedAt        DateTime?

  isActive Boolean @default(true)
  ownerId  String? // null = 平台公用；有值 = 商户专属
  owner    Tenant? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depositOrders DepositOrder[]
  withdrawals   Withdrawal[]

  @@index([ownerId, isActive])
  @@index([isActive])
  @@index([gatewayType, isActive])
  @@index([isPlatformGateway, reviewStatus])
}

// 13. 充值订单 (DepositOrder - 玩家充值 / 上分)
// status: pending -> success / failed。只有 pending -> success 的原子更新成功者才能给玩家加余额。
// orderNo: 商户订单号（DEP_<毫秒时间戳>_<6 位随机>），支付商回调按它回查订单；
// 历史数据允许为空，回调同时兼容用主键 id 回查。
model DepositOrder {
  id        String         @id @default(uuid())
  orderNo   String?        @unique
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  playerId  String
  player    Player         @relation(fields: [playerId], references: [id])
  amount    Decimal        @db.Decimal(18, 6)
  currency  String         @default("USDT")
  status    String         @default("pending") // pending, success, failed
  txHash    String? // 支付商交易号 / 区块链哈希
  gatewayId String
  gateway   PaymentGateway @relation(fields: [gatewayId], references: [id])

  createdAt DateTime @default(now())

  referralReward ReferralReward?

  @@unique([gatewayId, txHash])
  @@index([tenantId, createdAt])
  @@index([playerId, createdAt])
  @@index([gatewayId, createdAt])
  @@index([status])
  @@index([txHash])
}

// 14. AI 对话日志 (AiChatLog)
// role: user / assistant；agentType: sales（销冠 AI）/ tech / support。
// content 在写入前统一做脱敏（邮箱、手机号、钱包地址、TG 账号），
// 联系方式只保留在 LeadRecord.tgOrEmail 里，供超管跟进。
// leadId 为空代表「还没绑定线索」的售前咨询，删除线索时置空而不是删日志。
//
// 多租户隔离：
// - tenantId 为空 = 平台侧对话（销冠 AI 招商、技术 / 财务助手）；
// - tenantId 有值 = 某个商户站内玩家与 AI 客服的对话（agentType=support），
//   商户后台 /tenant/ai-logs 只能按自己的 tenantId 查询。
// - playerId 为空代表未登录访客（仍然归属到 tenantId，便于商户查看访客咨询）。
model AiChatLog {
  id        String      @id @default(uuid())
  role      String // user, assistant
  content   String      @db.Text
  agentType String      @default("sales") // sales, tech, finance, audit, strategist（support 为历史兼容）
  leadId    String?
  lead      LeadRecord? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  tenantId  String?
  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId  String?
  player    Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([agentType, createdAt])
  @@index([leadId, createdAt])
  @@index([tenantId, createdAt])
  @@index([playerId, createdAt])
}

// 15. 客户线索 / 招商战败分析 (LeadRecord)
// status: pending（跟进中）/ success（已开站）/ failed（明确拒绝）
// failReason 只允许 5 个字以内，由 AI 工具 save_lead_failure_reason 写入，
// 例如「价格贵」「没流量」「怕黑台」「不信任」「不会推」。
model LeadRecord {
  id         String   @id @default(uuid())
  tgOrEmail  String // 客户 Telegram / 邮箱（线索联系方式）
  brandName  String // 客户品牌名
  status     String   @default("pending") // pending, success, failed
  failReason String? // 5 字以内战败原因
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chatLogs AiChatLog[]

  @@unique([tgOrEmail, brandName])
  @@index([status, updatedAt])
  @@index([failReason])
}

// 16. AI 全局接入配置 (AiSettings)
// 单例记录，固定 id = "global"。apiKey 只允许服务端读取，接口返回前必须掩码。
// provider：deepseek / openai；model 为全局默认模型，Agent 未单独指定时使用。
// isActive=false 时所有云端调用视为未配置，前端会提示先启用接入。
model AiSettings {
  id        String   @id @default("global")
  provider  String   @default("deepseek") // deepseek, openai
  apiKey    String   @default("")
  baseUrl   String   @default("https://api.deepseek.com")
  model     String   @default("deepseek-chat")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 17.1 AI 助手专属知识库 (AgentFaq)
// tenantId 为空 = 平台级 FAQ（所有对话可用）；有值 = 指定商户 FAQ。
// 检索时平台级与当前商户级 FAQ 会一起参与匹配，最多取 3 条拼入 System Prompt。
model AgentFaq {
  id        String   @id @default(uuid())
  agentType String   @default("sales") // sales, tech, finance, audit, strategist
  question  String   @db.Text
  answer    String   @db.Text
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentType, tenantId, updatedAt])
  @@index([tenantId])
}

// 17. AI 智能体配置 (AgentConfig)
// agentName：sales / tech / finance / audit / strategist（support 为历史兼容）
// systemPrompt：基础人设与工具规则；tactics：战败复盘沉淀的标准话术
// 真正下发给模型的 System Prompt = systemPrompt + tactics（见 src/lib/ai/prompts.ts）。
// @@map 保留旧表名，升级阶段不会丢已有提示词与战术沉淀。
model AgentConfig {
  id           String   @id @default(uuid())
  agentName    String   @unique @map("agentType")
  systemPrompt String   @db.Text
  tactics      String   @default("") @db.Text
  model        String   @default("deepseek-chat")
  isEnabled    Boolean  @default(true)
  tokenLimit   Int      @default(2000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("AiAgentConfig")
}

// 18. KYC 实名认证 (PlayerKyc)
// 状态与平台网关审核（GatewayReviewStatus）完全是同一套语义：
//   PENDING  玩家已提交，等待商户老板审核；
//   APPROVED 审核通过，提现接口才放行（见 /api/withdrawal/create 的前置校验）；
//   REJECTED 审核驳回，rejectReason 必填，玩家可带新资料重新提交（覆盖本条记录并回到 PENDING）。
//
// 多租户隔离：tenantId 与 playerId 同时落库，playerId 库层唯一（一个玩家只有一条），
// 商户后台所有查询固定 where: { tenantId }，别家玩家的申请既查不到也审不了。
//
// 证件图片：idCardFrontUrl / idCardBackUrl 存的是「受控访问路径」
// （/api/player/kyc/files/<key>），文件本体放在仓库外的私有目录 .kyc-storage/，
// 必须带玩家或商户会话才能读取。生产环境应替换成对象存储 + 短期签名 URL。
enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model PlayerKyc {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId       String    @unique
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  realName       String // 真实姓名
  idNumber       String // 证件号码
  idCardFrontUrl String // 证件正面（受控访问路径，非公网直链）
  idCardBackUrl  String // 证件反面（受控访问路径，非公网直链）
  status         KycStatus @default(PENDING)
  rejectReason   String? // 仅 REJECTED 时有值
  reviewedById   String? // 审核人（AdminUser.id），超管代审时也会记录
  reviewedBy     AdminUser? @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
}

// 19. 全局 IP 白名单（API 集成中心 /admin/integrations 区域 B）
// 下游商户共用同一份白名单：只有命中名单的调用方来源 IP 才允许调用开放接口。
// ip 支持单个 IPv4 / IPv6 或 CIDR 段（如 203.0.113.10、203.0.113.0/24），
// 唯一键保证重复粘贴同一批 IP 时不会产生重复行。
// createdBy 只记 AdminUser.id 用于审计，不建外键：员工账号被删不应连带清空白名单。
model IntegrationIpWhitelist {
  id        String   @id @default(uuid())
  ip        String   @unique
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 20. 活动分类 (PromotionCategory)
// 玩家前台「活动大厅」（/promotions）左侧的分类导航：全部优惠（虚拟）、新人优惠、周周返水…
// - tenantId 多租户隔离：每个商户维护自己的分类，查询必须带 tenantId；
// - name 在同一商户内唯一（同名分类没有意义，且会让运营分不清哪条对应哪个 Banner）；
// - sortOrder 越小越靠前，前端按 (sortOrder asc, createdAt asc) 排序，脏数据不会乱跳。
model PromotionCategory {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  banners PromotionBanner[]

  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
}

// 21. 活动 Banner (PromotionBanner)
// 一个分类下挂 N 张活动图，玩家端只渲染 isActive=true 的；
// - imageUrl：商户上传（落 .promotion-storage/，走 /api/promotions/banners/<key> 直链）
//             或直接填外站 https 图片地址，两种都由 normalizePromotionUrl() 统一校验；
// - linkUrl：点击跳转地址，允许站内 /player/register 这类相对路径与外站 https 链接；
// - categoryId 建了外键并级联删除：删分类即连带删掉该分类下的活动图（后台会二次确认）。
model PromotionBanner {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId String
  category   PromotionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageUrl   String
  // 手机端专用海报（可选）：<768px 时前台优先用它，object-cover 铺满手机舞台。
  // 不填时前台自动回落成「电脑图模糊底 + 完整显示」的双层兜底，绝不出现黑边/空白。
  // 读写口径见 lib/promotions.ts 的 parsePromotionBannerInput；
  // 渲染唯一实现见 components/lobby/hero-poster-image.tsx（禁止另写一套 img 叠加）。
  mobileImageUrl String?
  title      String?
  linkUrl    String?
  isActive   Boolean           @default(true)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([tenantId, isActive, sortOrder])
  @@index([categoryId, sortOrder])
}
// 22. 红利活动 (BonusCampaign)
// 商户后台【活动红利管理】(/tenant/bonuses) 维护，玩家在前台点击领取。
//
// 防套利三道闸门（缺一不可，见 src/lib/bonus-campaigns.ts）：
//   1. isActive 总开关，**默认 false**：建完活动不会自动上线，必须商户手动启用；
//   2. 时间窗 startAt / endAt：领取时实时校验 now ∈ [startAt, endAt]，
//      过了 endAt 即使 isActive 还是 true 也一律拒绝（= 自动下线，不需要定时任务）；
//   3. 玩家 + 活动唯一：PlayerBonusClaim 的 @@unique([playerId, campaignId])。
//
// rewardAmount：奖励金额（本站记账币种）；
// turnoverMultiplier：所需流水倍数（奖励 × 倍数 = 提现前必须打满的流水）；
// currency：领取瞬间的 Tenant.currency 快照，事后商户改币种不会重算历史奖励。
model BonusCampaign {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  type               BonusCampaignType @default(register)
  rewardAmount       Decimal           @db.Decimal(18, 6)
  turnoverMultiplier Decimal           @db.Decimal(9, 2)
  currency           String            @default("MYR")

  startAt  DateTime
  endAt    DateTime
  isActive Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims PlayerBonusClaim[]

  @@index([tenantId, isActive, startAt])
  @@index([tenantId, endAt])
  @@index([tenantId, createdAt])
}

// 22.1 红利类型
//   register      注册彩金：玩家注册时间必须落在活动时间窗内；
//   deposit       存款彩金：活动时间窗内至少有一笔成功充值；
//   first_deposit 首充彩金：玩家的**第一笔**成功充值必须发生在活动时间窗内。
enum BonusCampaignType {
  register
  deposit
  first_deposit
}


// 23. 玩家红利领取记录 (PlayerBonusClaim)
// 一条记录 = 一笔已发放的奖励 + 一笔待完成的流水要求，也是提现拦截的唯一依据。
//
// 状态机：
//   PENDING   奖励已加进余额，流水要求还没打满 → **禁止提现**
//   COMPLETED 流水要求已打满（下注回调里累计，见 accrueBonusTurnover）
//
// requiredTurnover = rewardAmount × turnoverMultiplier（领取时算好，事后改活动不影响历史）；
// wageredTurnover  = 已经打掉的流水（只增不减，按下注金额累计）；
// transactionId    ：对应的奖金入账流水（Transaction.type = "bonus"，唯一）。
model PlayerBonusClaim {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignId String
  campaign   BonusCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)

  rewardAmount     Decimal @db.Decimal(18, 6)
  requiredTurnover Decimal @db.Decimal(18, 6)
  wageredTurnover  Decimal @default(0) @db.Decimal(18, 6)
  currency         String  @default("MYR")

  status        BonusClaimStatus @default(PENDING)
  transactionId String?          @unique
  claimedAt     DateTime         @default(now())
  completedAt   DateTime?
  updatedAt     DateTime         @updatedAt

  // 同一个玩家同一个活动只能领一次（并发重复点击由数据库兜住 → P2002）
  @@unique([playerId, campaignId])
  @@index([tenantId, status])
  @@index([playerId, status])
  @@index([tenantId, claimedAt])
}

enum BonusClaimStatus {
  PENDING
  COMPLETED
}


// 24. 每日洗码结算单 (RebatePayout)
// Cron（scripts/rebate-settlement.ts 或 POST /api/cron/rebate-settlement）每天凌晨跑一次，
// 按「商户 + 玩家 + 品类 + UTC 日界」聚合前一天的流水后发放。
//
// - 唯一键 @@unique([tenantId, playerId, category, periodStart]) 是**幂等闸门**：
//   定时任务被重跑 / 补跑时命中 P2002 直接跳过，绝不会重复发钱；
// - periodStart 存 UTC 日界（Date 类型），与 DailyBonusClaim.claimDate 同一口径；
// - ratePercent 是**结算瞬间**的费率快照（0.5 = 0.5%），事后改费率不重算历史；
// - transactionId 指向对应入账流水（Transaction.type = "rebate"）。
model RebatePayout {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  category    String
  periodStart DateTime @db.Date

  turnover     Decimal @db.Decimal(18, 6)
  ratePercent  Decimal @db.Decimal(9, 4)
  rebateAmount Decimal @db.Decimal(18, 6)
  currency     String  @default("MYR")

  transactionId String?  @unique
  createdAt     DateTime @default(now())

  @@unique([tenantId, playerId, category, periodStart])
  @@index([tenantId, periodStart])
  @@index([createdAt])
}

