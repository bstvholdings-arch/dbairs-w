# ---------------------------------------------------------------------------
# 磁盘红线（见 AGENTS.md 第 16 条）：本机 C 盘只剩不到 8GB，
# npm 的缓存 / 临时解包目录**必须**留在 D 盘项目内，禁止写系统盘。
#
# 这里刻意用**相对路径**：npm 会按本文件所在目录（D:\dbairs-w）解析，
# 所以本机落在 D:\dbairs-w\.npm-cache；部署到 Linux / Vercel 时同样只能落在项目内，
# 不会出现「Windows 绝对路径在 Linux 上变成非法目录」的问题。
#
# 想强制回到默认（全局缓存）时：npm install --cache "$env:TEMP\npm-cache"
# ---------------------------------------------------------------------------
cache=.npm-cache
# 注意：npm 11 起 `.npmrc` 里的 `tmp` 已是未知配置（会打 warn），
# 临时解包目录只能靠环境变量控制，安装前请执行：
#   $env:TEMP='D:\dbairs-w\.npm-tmp'; $env:TMP=$env:TEMP

# 少一点无关流量：不拉赞助信息、不做自动审计（CI 里有独立的审计步骤）
fund=false
audit=false
